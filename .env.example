# ==============================================================================
# BOVARO REAL ESTATE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Duplicate this file to '.env.local' for local development.
# IMPORTANT: Do NOT store sensitive production credentials or secrets here.
# ==============================================================================

# Application & Canonical Domain Configuration
# Set NEXT_PUBLIC_APP_URL to the approved production domain when connected.
# Preview/localhost URLs automatically fall back to NEXT_PUBLIC_PRODUCTION_DOMAIN
# so staging URLs are never exposed as canonical URLs.
NEXT_PUBLIC_SITE_NAME="Bovaro Real Estate"
NEXT_PUBLIC_APP_URL="https://bovarorealestate.com"
NEXT_PUBLIC_PRODUCTION_DOMAIN="https://bovarorealestate.com"

# Indexing Control ("true" | "false")
# Leave unset to automatically allow indexing ONLY on production domain deployments
# and block indexing (noindex, nofollow + Disallow: /) on Vercel preview deployments.
# Set to "false" until the final production domain is live and approved.
NEXT_PUBLIC_INDEXING_ENABLED="true"

# Search Console & Analytics Readiness (Set once domain & accounts are authorized)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="EHbe9bYRxB28MLR9fzu1k_aXLy9BqFP_fYB4yg-Dxbo"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""

# Feature Flags (Optional)
NEXT_PUBLIC_ENABLE_3D_SHOWCASE="false"
